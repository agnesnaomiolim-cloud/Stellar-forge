{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "StellarFailover defines multi-cluster active-passive failover orchestration",
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "primaryCluster",
        "passiveCluster",
        "globalDomain"
      ],
      "properties": {
        "primaryCluster": {
          "type": "string",
          "description": "Name of the primary cluster"
        },
        "passiveCluster": {
          "type": "string",
          "description": "Name of the passive cluster"
        },
        "globalDomain": {
          "type": "string",
          "description": "Global DNS domain to remap during failover"
        },
        "healthCheckInterval": {
          "type": "string",
          "default": "500ms",
          "description": "Interval for polling primary cluster health endpoints"
        },
        "healthCheckTimeout": {
          "type": "string",
          "default": "2s",
          "description": "Timeout for individual health check requests"
        },
        "failureThreshold": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Consecutive failed health checks before triggering failover"
        },
        "successThreshold": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Consecutive successful health checks before allowing failback"
        },
        "antiFlappingWindow": {
          "type": "string",
          "default": "5m",
          "description": "Minimum time between failover transitions to prevent flapping"
        },
        "failoverTimeout": {
          "type": "string",
          "default": "60s",
          "description": "Maximum time allowed to complete failover"
        },
        "dnsProvider": {
          "type": "object",
          "description": "Cloud DNS provider configuration",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Route53",
                "Cloudflare"
              ]
            },
            "hostedZoneId": {
              "type": "string"
            },
            "ttl": {
              "type": "integer",
              "default": 30,
              "minimum": 1
            },
            "credentialsSecretRef": {
              "type": "string"
            }
          }
        },
        "databasePromotion": {
          "type": "object",
          "description": "PostgreSQL replica promotion configuration",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "patroniEndpoint": {
              "type": "string"
            },
            "promotionTimeout": {
              "type": "string",
              "default": "30s"
            },
            "verifyReplicationLag": {
              "type": "boolean",
              "default": true
            },
            "maxReplicationLagSeconds": {
              "type": "integer",
              "default": 10
            }
          }
        },
        "autoFailback": {
          "type": "boolean",
          "default": false,
          "description": "Automatically fail back when primary recovers"
        },
        "notificationEmail": {
          "type": "string",
          "description": "Email for failover event notifications"
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Healthy",
            "Degraded",
            "FailingOver",
            "FailedOver",
            "FailingBack",
            "Unknown"
          ]
        },
        "activeCluster": {
          "type": "string",
          "description": "Cluster currently serving global traffic"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "lastHealthCheckTime": {
          "type": "string",
          "format": "date-time"
        },
        "consecutiveFailures": {
          "type": "integer",
          "default": 0
        },
        "consecutiveSuccesses": {
          "type": "integer",
          "default": 0
        },
        "lastFailoverTime": {
          "type": "string",
          "format": "date-time"
        },
        "lastFailoverDuration": {
          "type": "string"
        },
        "failoverCount": {
          "type": "integer",
          "default": 0
        },
        "observedGeneration": {
          "type": "integer"
        }
      }
    },
    "apiVersion": {
      "type": "string",
      "enum": [
        "stellar.org/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "StellarFailover"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "additionalProperties": true,
  "x-kubernetes-group-version-kind": [
    {
      "group": "stellar.org",
      "version": "v1alpha1",
      "kind": "StellarFailover"
    }
  ]
}
